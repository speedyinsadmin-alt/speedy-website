{
  "crons": [
    {
      "path": "/api/platform?view=cron_sync",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/rc-subscribe?action=renew&cron=1",
      "schedule": "0 8 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/qr",
      "destination": "/quote.html?src=qr",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
